# Kopieren nach `.env` und den Key eintragen (wird vom Trainer ausgegeben)
OPENAI_API_KEY=sk-...

# Modelle (Stand 09/2026). Guenstig fuer Labs: gpt-5.6-luna; Judge etwas staerker: gpt-5.6-terra
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_JUDGE_MODEL=gpt-5.6-terra
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536
# "none" = kein Reasoning (schnell/guenstig). Leer lassen, falls das gewaehlte Modell den Parameter nicht kennt.
OPENAI_REASONING_EFFORT=none

# Offline-Modus ohne API (nur Plumbing-Tests, keine echte Semantik): FAKE_EMBEDDINGS=1
FAKE_EMBEDDINGS=0

# Qdrant lokaler Modus: ":memory:" (Standard) oder ein Pfad wie ".qdrant" fuer Persistenz
QDRANT_LOCATION=:memory:

# Preise fuer Kostenschaetzung (USD pro 1 Mio Tokens) - an das gewaehlte Modell anpassen
PRICE_INPUT_PER_MTOK=0.20
PRICE_OUTPUT_PER_MTOK=1.20
PRICE_EMBED_PER_MTOK=0.02
